<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitnessTracker.Presentation.Views.VoiceInputPage"
             Title="Голосовой помощник"
             BackgroundColor="White">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🏠 Главная" 
                     Command="{Binding NavigateToDashboardCommand}" 
                     Order="Primary" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Голосовой ассистент" FontSize="24" TextColor="Black" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,10,0,0" />
            <Label Text="" FontSize="14" TextColor="Gray" HorizontalOptions="Center" />

            <!-- КАРТОЧКА ОТОБРАЖЕНИЯ РЕЧИ -->
            <Frame CornerRadius="12" Padding="20" HasShadow="True" BorderColor="Transparent" BackgroundColor="LIghtGreen" Margin="0,10,0,0">
                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="15">

                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Spacing="10" VerticalOptions="Center">
                        <Label Text="" TextColor="#AED6F1" FontSize="12" FontAttributes="Bold" />

                        <!-- Именно этот Label выводит сказанный текст на экран в реальном времени -->
                        <Label Text="{Binding VoiceText}" 
                       TextColor="White" 
                       FontSize="18" 
                       FontAttributes="Italic"
                       LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <!-- Круглая кнопка микрофона с триггером цвета -->
                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" 
                    Text="🎙️" 
                    Command="{Binding ToggleVoiceCommand}"
                    BackgroundColor="#1B4F72" 
                    TextColor="White" HeightRequest="65" WidthRequest="65" CornerRadius="32" VerticalOptions="Center">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsRecording}" Value="True">
                                <Setter Property="BackgroundColor" Value="#E74C3C" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Frame>

            <!-- Анимация загрузки: Показывается только во время говорения -->
            <ActivityIndicator IsRunning="{Binding IsRecording}" 
                       IsVisible="{Binding IsRecording}" 
                       Color="#2980B9" 
                       HorizontalOptions="Center" 
                       HeightRequest="40" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
